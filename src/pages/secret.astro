---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Secret – LaserSETI" description="A password-protected LaserSETI page." />
	</head>
	<body>
		<Header />
		<main>
			<section class="secret-gate" aria-labelledby="access-heading">
				<h1 id="access-heading">Protected page</h1>
				<p>Enter the password to continue.</p>
				<form id="secret-form">
					<label for="secret-password">Password</label>
					<div class="password-row">
						<input id="secret-password" name="password" type="password" autocomplete="current-password" required />
						<button type="submit">Unlock</button>
					</div>
					<p class="secret-error" id="secret-error" role="alert" aria-live="polite"></p>
				</form>
			</section>

			<section class="secret-content" id="secret-content" hidden>
				<h1>Secret</h1>
				<p>This is the secret page.</p>
			</section>
		</main>
		<Footer />

		<script>
			const expectedHash = '2813d9273c5cdb30312ab50194d19ae9774ecf1e8702fe78b25d2c2c54471400';
			const form = document.querySelector('#secret-form');
			const gate = document.querySelector('.secret-gate');
			const content = document.querySelector('#secret-content');
			const passwordInput = document.querySelector('#secret-password');
			const error = document.querySelector('#secret-error');

			const reveal = () => {
				gate?.setAttribute('hidden', '');
				content?.removeAttribute('hidden');
			};

			if (sessionStorage.getItem('laserseti-secret-access') === expectedHash) reveal();

			form?.addEventListener('submit', async (event) => {
				event.preventDefault();
				if (!(passwordInput instanceof HTMLInputElement)) return;

				const bytes = new TextEncoder().encode(passwordInput.value);
				const digest = await crypto.subtle.digest('SHA-256', bytes);
				const hash = Array.from(new Uint8Array(digest), (byte) => byte.toString(16).padStart(2, '0')).join('');

				if (hash === expectedHash) {
					sessionStorage.setItem('laserseti-secret-access', hash);
					reveal();
					return;
				}

				if (error) error.textContent = 'Incorrect password. Try again.';
				passwordInput.select();
			});
		</script>
	</body>
</html>

<style>
	.secret-gate,
	.secret-content {
		max-width: 38rem;
		margin: 0 auto;
	}

	.secret-gate[hidden],
	.secret-content[hidden] {
		display: none;
	}

	label {
		display: block;
		margin-bottom: 0.4rem;
		font-weight: 700;
	}

	.password-row {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 0.6rem;
	}

	input,
	button {
		box-sizing: border-box;
		min-height: 2.75rem;
		border: 1px solid rgb(var(--gray));
		border-radius: 0.25rem;
		font: inherit;
	}

	input {
		width: 100%;
		padding: 0.55rem 0.7rem;
	}

	button {
		padding: 0.55rem 1.1rem;
		border-color: var(--accent);
		background: var(--accent);
		color: #fff;
		font-weight: 700;
		cursor: pointer;
	}

	input:focus-visible,
	button:focus-visible {
		outline: 3px solid var(--accent);
		outline-offset: 2px;
	}

	.secret-error {
		min-height: 1.5em;
		margin-top: 0.5rem;
		color: #a11212;
		font-size: 0.9rem;
	}

	@media (max-width: 520px) {
		.password-row {
			grid-template-columns: 1fr;
		}
	}
</style>
